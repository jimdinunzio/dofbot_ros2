Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Planned Path:
        # Loop Animation replays each planned trajectory forever. With
        # pick_place driving a sequence of segments that shows up as a
        # translucent "ghost" arm cycling through the previous segment while
        # the real one executes the next. Show Trail is worse -- it draws every
        # waypoint at once, giving a stack of ghost arms. Both stay off.
        Loop Animation: false
        Show Trail: false
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Request:
        # Both ghost robots off. They are the ends of a drag-the-marker query,
        # and nothing here drags a marker -- pick_place sets its goals from
        # code. The goal ghost defaults to ON, in orange (250, 128, 0), parked
        # straight up, and once anything is attached it draws a SECOND copy of
        # the held object hanging off it. Same reasoning as Loop Animation and
        # Show Trail above: ghost arms are noise when you are driving from code.
        Query Goal State: false
        Query Start State: false
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        # Was 1, briefly 0.25, now off entirely. The only world collision
        # objects this robot ever has are graspable targets, and scene_markers
        # draws each of those as its real mesh at exactly the same place and
        # size -- scaled from the same catalogue numbers the cylinder is built
        # from, so the two cannot disagree. Two coincident surfaces z-fight,
        # and MoveIt wins: a green (50, 230, 50) cylinder with shards of the
        # can flickering through it. Fading it to 0.25 only made a green haze.
        #
        # The primitive is redundant, so it is hidden rather than blended.
        #
        # COST: an object with no `mesh` in the catalogue now draws NOTHING.
        # test_block is one. Raise this to see those again.
        #
        # The chassis and floor are NOT affected: chassis.xacro makes them real
        # URDF links, so they draw as part of the robot, not as scene geometry.
        Scene Alpha: 0
      Scene Robot:
        # Was 0.5. That half-alpha is for seeing a ghost of MoveIt's idea of
        # the robot THROUGH a separately-drawn solid one; this config has no
        # separate robot display, so it was making the only arm on screen --
        # and the chassis with it -- translucent for no benefit.
        Robot Alpha: 1
      Value: true
    # The target drawn as its real textured mesh, published by
    # dofbot_ctrl.scene_markers. Cosmetic: MotionPlanning above already draws
    # what is actually planned against, which is a plain cylinder.
    #
    # Durability MUST be Transient Local to match the publisher. Left at the
    # default Volatile the display is still compatible -- so no warning appears
    # -- but an RViz started after the pick began shows nothing until the can
    # next moves, which looks like the mesh failing to load.
    - Class: rviz_default_plugins/Marker
      Name: Graspable Objects
      Enabled: true
      Namespaces:
        graspable: true
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /graspable_objects
      Value: true
  Global Options:
    Fixed Frame: base_link
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: -0.1
        Y: 0.25
        Z: 0.30
      Name: Current View
      Pitch: 0.5
      Target Frame: base_link
      Yaw: -0.623
Window Geometry:
  Height: 975
  QMainWindow State: 
  Width: 1200
