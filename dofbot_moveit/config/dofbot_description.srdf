<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="dofbot_description">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="arm_group">
        <joint name="arm1_Joint"/>
        <joint name="arm2_Joint"/>
        <joint name="arm3_Joint"/>
        <joint name="arm4_Joint"/>
        <joint name="arm5_Joint"/>
    </group>
    <group name="grip_group">
        <link name="Rlink1_Link"/>
        <link name="Rlink2_Link"/>
        <link name="Rlink3_Link"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <group_state name="up" group="arm_group">
        <joint name="arm1_Joint" value="0"/>
        <joint name="arm2_Joint" value="0"/>
        <joint name="arm3_Joint" value="0"/>
        <joint name="arm4_Joint" value="0"/>
        <joint name="arm5_Joint" value="0"/>
    </group_state>
    <group_state name="down" group="arm_group">
        <joint name="arm1_Joint" value="0"/>
        <joint name="arm2_Joint" value="1.57"/>
        <joint name="arm3_Joint" value="0"/>
        <joint name="arm4_Joint" value="0"/>
        <joint name="arm5_Joint" value="0"/>
    </group_state>
    <!--The four arm states below are mirrored in dofbot_ctrl/moveit_client.py
        (NAMED_STATES); change both together. dofbot_ctrl's
        test/test_named_states.py parses this file and fails if they diverge. Each was validated against the
        live planning scene by `pick_place` in its check-states mode, rather
        than eyeballed in RViz.
        The vendor's {0, -1.57, 1.57, 1.57, 0} is not used here. It was dropped
        for arm3_Link/chassis_link contact, which held against a 0.165 m chassis
        radius; at the measured 0.1596 that pose clears the cylinder by 5.4 mm,
        so that reason no longer stands on its own.-->
    <!--Can-looking pose: folded low and forward, TCP
        (0.098, 0.001, 0.095), phi=2.251. It clears the CHASSIS OAK-D's view of
        a can on the floor, which is what it is measured against.
        Posed by hand on the real arm and read with calibrate_zero as servo
        medians {1: 90.0, 2: 168.0, 3: -35.0, 4: 11.0, 5: 88.0}, which
        joint_map.servo_to_urdf turns into {0.00, -76.00, 127.00, 81.00, 0.00}
        degrees. The arm's parts touch at 127, so arm3 is backed off to 124
        here; arm3_Joint's URDF limit is +127, that contact.-->
    <group_state name="init" group="arm_group">
        <joint name="arm1_Joint" value="0.0"/>
        <joint name="arm2_Joint" value="-1.3265"/>
        <joint name="arm3_Joint" value="2.1642"/>
        <joint name="arm4_Joint" value="1.4137"/>
        <joint name="arm5_Joint" value="0"/>
    </group_state>
    <!--Boot, drive and carry pose: leaned back and tucked, TCP
        (0.063, 0.001, 0.198), phi=1.57, out of the lidar's view. Given as
        servo angles {1: 90.0, 2: 180.0, 3: 4.0, 4: 1.0, 5: 87.0}, which
        joint_map.servo_to_urdf turns into {0.00, -88.00, 88.00, 91.00, -1.00}
        degrees; arm4 is clamped to its 89.95 limit.-->
    <group_state name="stow" group="arm_group">
        <joint name="arm1_Joint" value="0.0"/>
        <joint name="arm2_Joint" value="-1.5359"/>
        <joint name="arm3_Joint" value="1.5359"/>
        <joint name="arm4_Joint" value="1.5700"/>
        <joint name="arm5_Joint" value="-0.0175"/>
    </group_state>
    <!--Release pose: TCP (0.167, 0.001, 0.334), phi=1.15, straight in front and
        high. The posture measured on the arm off the left front, rotated
        on-axis - theta1 is the only joint that moved. A PLACEHOLDER for a bin
        perception has yet to find: it assumes a rim below ~0.3 m, 0.167 m out,
        which is barely past the chassis.-->
    <group_state name="over_trash" group="arm_group">
        <joint name="arm1_Joint" value="0.0"/>
        <joint name="arm2_Joint" value="0.229"/>
        <joint name="arm3_Joint" value="-0.025"/>
        <joint name="arm4_Joint" value="0.942"/>
        <joint name="arm5_Joint" value="0.0"/>
    </group_state>
    <!-- Not the joint's lower limit. The linkage is over-centre: span peaks with
         the gear arms parallel and falls away on both sides, and that peak sits
         a little above the limit, so commanding 0 opens LESS wide. Keep this in
         step with gripper.OPEN_ANGLE. See joint_map. -->
    <group_state name="open" group="grip_group">
        <joint name="Rlink1_Joint" value="0.034"/>
    </group_state>
    <group_state name="close" group="grip_group">
        <joint name="Rlink1_Joint" value="1.5"/>
    </group_state>
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="gripper" parent_link="arm5_Link" group="grip_group"/>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="Camera_Link" link2="Gripping_point_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="Llink1_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="Llink2_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="Llink3_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="Rlink1_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="Rlink2_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="Rlink3_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Camera_Link" link2="arm4_Link" reason="Adjacent"/>
    <disable_collisions link1="Camera_Link" link2="arm5_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="Llink1_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="Llink2_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="Llink3_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="Rlink1_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="Rlink2_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="Rlink3_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="arm1_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Gripping_point_Link" link2="arm4_Link" reason="Default"/>
    <disable_collisions link1="Gripping_point_Link" link2="arm5_Link" reason="Adjacent"/>
    <disable_collisions link1="Llink1_Link" link2="Llink2_Link" reason="Adjacent"/>
    <disable_collisions link1="Llink1_Link" link2="Llink3_Link" reason="Never"/>
    <disable_collisions link1="Llink1_Link" link2="Rlink1_Link" reason="Default"/>
    <disable_collisions link1="Llink1_Link" link2="Rlink2_Link" reason="Never"/>
    <disable_collisions link1="Llink1_Link" link2="Rlink3_Link" reason="Never"/>
    <disable_collisions link1="Llink1_Link" link2="arm1_Link" reason="Never"/>
    <disable_collisions link1="Llink1_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Llink1_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Llink1_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="Llink1_Link" link2="arm5_Link" reason="Adjacent"/>
    <disable_collisions link1="Llink2_Link" link2="Llink3_Link" reason="Default"/>
    <disable_collisions link1="Llink2_Link" link2="Rlink1_Link" reason="Never"/>
    <disable_collisions link1="Llink2_Link" link2="Rlink2_Link" reason="Never"/>
    <disable_collisions link1="Llink2_Link" link2="Rlink3_Link" reason="Never"/>
    <disable_collisions link1="Llink2_Link" link2="arm1_Link" reason="Never"/>
    <disable_collisions link1="Llink2_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Llink2_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Llink2_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="Llink2_Link" link2="arm5_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="Rlink1_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="Rlink2_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="Rlink3_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="arm1_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="Llink3_Link" link2="arm5_Link" reason="Adjacent"/>
    <disable_collisions link1="Rlink1_Link" link2="Rlink2_Link" reason="Adjacent"/>
    <disable_collisions link1="Rlink1_Link" link2="Rlink3_Link" reason="Never"/>
    <disable_collisions link1="Rlink1_Link" link2="arm1_Link" reason="Never"/>
    <disable_collisions link1="Rlink1_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Rlink1_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Rlink1_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="Rlink1_Link" link2="arm5_Link" reason="Adjacent"/>
    <disable_collisions link1="Rlink2_Link" link2="Rlink3_Link" reason="Default"/>
    <disable_collisions link1="Rlink2_Link" link2="arm1_Link" reason="Never"/>
    <disable_collisions link1="Rlink2_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Rlink2_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Rlink2_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="Rlink2_Link" link2="arm5_Link" reason="Never"/>
    <disable_collisions link1="Rlink3_Link" link2="arm1_Link" reason="Never"/>
    <disable_collisions link1="Rlink3_Link" link2="arm2_Link" reason="Never"/>
    <disable_collisions link1="Rlink3_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="Rlink3_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="Rlink3_Link" link2="arm5_Link" reason="Adjacent"/>
    <disable_collisions link1="arm1_Link" link2="arm2_Link" reason="Adjacent"/>
    <disable_collisions link1="arm1_Link" link2="arm3_Link" reason="Never"/>
    <disable_collisions link1="arm1_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="arm1_Link" link2="arm5_Link" reason="Never"/>
    <disable_collisions link1="arm1_Link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_Link" link2="arm3_Link" reason="Adjacent"/>
    <disable_collisions link1="arm2_Link" link2="arm4_Link" reason="Never"/>
    <disable_collisions link1="arm2_Link" link2="arm5_Link" reason="Never"/>
    <disable_collisions link1="arm2_Link" link2="base_link" reason="Never"/>
    <disable_collisions link1="arm3_Link" link2="arm4_Link" reason="Adjacent"/>
    <disable_collisions link1="arm3_Link" link2="arm5_Link" reason="Never"/>
    <disable_collisions link1="arm3_Link" link2="base_link" reason="Never"/>
    <disable_collisions link1="arm4_Link" link2="arm5_Link" reason="Adjacent"/>
    <!--CHASSIS + FLOOR: base_link, chassis_link and floor_link are joined by
        fixed joints, so their relative poses never change and the collision
        result between them is a constant. Checking them every state is pure
        waste, so disable those three pairs. Collisions between these links and
        the moving arm/gripper links stay ENABLED - that is the whole point.-->
    <disable_collisions link1="base_link" link2="chassis_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="floor_link" reason="Adjacent"/>
    <disable_collisions link1="chassis_link" link2="floor_link" reason="Adjacent"/>
</robot>
